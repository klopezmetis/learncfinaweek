{
    "datasources":{
        "cfsqltraining":{
            "bundleName":"org.lucee.mssql",
            "bundleVersion":"13.2.1",
            "class":"com.microsoft.sqlserver.jdbc.SQLServerDriver",
            "connectionLimit":"100",
            "connectionTimeout":"1",
            "custom":"DATABASENAME=${DB_DATABASE}&instanceName=${DB_INSTANCE}&sendStringParametersAsUnicode=true&SelectMethod=direct",
            "database":"${DB_DATABASE}",
            "dbdriver":"MSSQL",
            "dsn":"jdbc:sqlserver://{host}:{port}",
            "host":"${DB_HOST}",
            "password":"${DB_PASSWORD}",
            "port":"${DB_PORT:1433}",
            "storage":"false",
            "username":"${DB_USER}"
        }
    },
    "robustExceptionEnabled":true
}
